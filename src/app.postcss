@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;



@font-face {
	/* Reference name */
	font-family: 'Bumbbled';
	/* For multiple files use commas, ex: url(), url(), ... */
	src: url('/fonts/Bumbbled.otf');
}
							

.gradient-heading {
	@apply bg-clip-text text-transparent box-decoration-clone;
	/* Direction */
	@apply bg-gradient-to-br;
	/* Color Stops */
	@apply from-primary-500 via-tertiary-500 to-primary-500;
}

.gradient-hero {
	@apply bg-clip-text text-transparent box-decoration-clone;
	/* Direction */
	@apply bg-gradient-to-br;
	/* Color Stops */
	@apply from-warning-500 via-primary-500 to-warning-500;
}

.gradient-tertiary {
	@apply bg-clip-text text-transparent box-decoration-clone;
	/* Direction */
	@apply bg-gradient-to-br;
	/* Color Stops */
	@apply from-tertiary-500 via-primary-500 to-tertiary-500;
}